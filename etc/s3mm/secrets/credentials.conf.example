# ---------------------------------------------------------------------------
# credentials.conf -- access keys for clusters
# ---------------------------------------------------------------------------
# credential <name> {
#     access_key <key>;
#     secret_key <secret>;
#     session_token <token>;  # optional (STS)
#     region <region>;        # optional default region
# }
#
# Reference by name from cluster { credential <name>; }
# Keep secrets in /etc/s3mm/secrets/ when possible and restrict permissions.
# ---------------------------------------------------------------------------

credential minio-admin {
    access_key minioadmin;
    secret_key minioadmin;
    region us-east-1;
}
